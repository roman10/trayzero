<?xml version="1.0" encoding="utf-8"?>
<!--
  Flutter's default `release` build also turns on resource shrinking
  (FlutterPlugin sets `isShrinkResources = true` for app modules). The
  notification icon passed to flutter_local_notifications
  (AndroidInitializationSettings('ic_stat_trayzero'), see
  lib/infrastructure/local_notification_scheduler.dart) is resolved by NAME at
  runtime, so the shrinker cannot see the reference and may strip the drawable
  -> the system fails to find the icon and the notification is silently
  dropped (flutter_local_notifications README, Android setup). Pin the
  launcher mipmaps and any drawables so reminders can always render.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_trayzero,@mipmap/ic_launcher,@mipmap/*,@drawable/*" />
