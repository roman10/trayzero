<?xml version="1.0" encoding="utf-8"?>
<!-- Today widget (ADR 0009). RemoteViews-safe: no Space (see 63789df), and an
     ImageView checkbox because CompoundButton needs API 31. Five fixed row
     slots; the rest folds into "+N more". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/today_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/today_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/today_widget_title"
            android:textColor="@color/today_widget_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/today_widget_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/today_check_0"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/today_title_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:textColor="@color/today_widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/today_check_1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/today_title_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:textColor="@color/today_widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/today_check_2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/today_title_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:textColor="@color/today_widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/today_check_3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/today_title_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:textColor="@color/today_widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/today_check_4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/today_title_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:textColor="@color/today_widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/today_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:textColor="@color/today_widget_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/today_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/today_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/today_widget_empty"
            android:textColor="@color/today_widget_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/today_plan_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/today_widget_button_background"
            android:text="@string/today_widget_plan"
            android:textAllCaps="false"
            android:textColor="@color/today_widget_on_accent" />
    </LinearLayout>
</LinearLayout>
