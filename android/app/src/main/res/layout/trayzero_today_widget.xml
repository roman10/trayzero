<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="12dp"
    android:paddingTop="@dimen/today_widget_vertical_padding"
    android:paddingBottom="@dimen/today_widget_vertical_padding">

    <include layout="@layout/trayzero_today_widget_header" />

    <LinearLayout
        android:id="@+id/today_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/today_more"
        android:layout_width="match_parent"
        android:layout_height="@dimen/today_widget_overflow_height"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/today_widget_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/today_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/today_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/today_widget_empty"
            android:textColor="@color/today_widget_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/today_plan_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/today_widget_button_background"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/today_widget_plan"
            android:textAllCaps="false"
            android:textColor="@color/today_widget_on_accent" />
    </LinearLayout>
</LinearLayout>
