<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/today_widget_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/today_row_check"
        android:layout_width="@dimen/today_widget_row_height"
        android:layout_height="match_parent"
        android:importantForAccessibility="yes"
        android:scaleType="center"
        android:src="@drawable/ic_widget_check" />

    <TextView
        android:id="@+id/today_row_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingEnd="4dp"
        android:textColor="@color/today_widget_text"
        android:textSize="15sp" />
</LinearLayout>
