<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Reminders are a core feature: due-date and weekly-review alerts must
         fire at the scheduled minute. Exact alarms are required — inexact
         AlarmManager gives a 1-hour delivery window (verified on-device:
         `dumpsys alarm` showed windowLength=3600000 for every app alarm), so
         short reminders are effectively lost. USE_EXACT_ALARM (API 33+) is
         auto-granted and Play-declared as a core alarm/reminder function.
         SCHEDULE_EXACT_ALARM covers Android 12 (API 31-32), where it is
         auto-granted; capped at 32 so it does NOT become the revocable,
         default-denied special-access permission on 13+ (which is exactly
         what regressed reminders to the inexact path). The in-app
         exact-alarm recovery UI stays as a fallback for any OEM that still
         denies it. RECEIVE_BOOT_COMPLETED re-arms pending alarms after a
         reboot / app update. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Speech-to-text in capture + voice-memo attachments -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Pulled in transitively (play-services-measurement, via a dependency),
         not by RevenueCat or any feature we use. Removed so Play does not
         require an Advertising ID declaration — the app shows no ads and reads
         no advertising ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- Photo attachments + camera. Gallery picks go through the Android
         system Photo Picker (image_picker_android ≥ 0.8.9+1 uses it by
         default on Android 13+ and falls back to ACTION_GET_CONTENT on
         older OS), so READ_MEDIA_IMAGES is intentionally NOT declared —
         Play rejects it for infrequent/optional photo use. CAMERA is
         still needed for the in-app "take a photo" action chip. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- System calendar sync (opt-in feature) -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>

    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Keep all entrypoints' default application affinity, matching AppAuth's
             receiver and singleTask authorization activity. An empty affinity
             sends browser callbacks to a new task without the pending state. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- cleartray:// links reach Dart through the home_widget launch
                 funnel (ADR 0009). Flutter's own deep linking would also push
                 the raw URI to go_router, whose empty path matches no route. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <!-- PackageManager prefers INFO for getLaunchIntentForPackage.
                     Notifications therefore always target this stable activity,
                     even after a launcher entry has been disabled. -->
                <category android:name="android.intent.category.INFO"/>
            </intent-filter>
            <!-- Receive SEND text/plain (e.g. "Share to Trayzero" from any app) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Widget deep links: cleartray://capture, cleartray://inbox -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="cleartray"/>
            </intent-filter>
        </activity>

        <!-- Launcher identity is separate from the always-enabled native entrypoint.
             Keep these names stable: Android persists the selected component. -->
        <activity
            android:name="app.cleartray.LauncherAmber"
            android:theme="@style/LaunchTheme.Amber"
            android:noHistory="true"
            android:relinquishTaskIdentity="true"
            android:enabled="true"
            android:exported="true"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="app.cleartray.LauncherBlue"
            android:theme="@style/LaunchTheme.Blue"
            android:noHistory="true"
            android:relinquishTaskIdentity="true"
            android:enabled="false"
            android:exported="true"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher_blue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="app.cleartray.LauncherCyan"
            android:theme="@style/LaunchTheme.Cyan"
            android:noHistory="true"
            android:relinquishTaskIdentity="true"
            android:enabled="false"
            android:exported="true"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher_cyan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="app.cleartray.LauncherTeal"
            android:theme="@style/LaunchTheme.Teal"
            android:noHistory="true"
            android:relinquishTaskIdentity="true"
            android:enabled="false"
            android:exported="true"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher_teal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="app.cleartray.LauncherGreen"
            android:theme="@style/LaunchTheme.Green"
            android:noHistory="true"
            android:relinquishTaskIdentity="true"
            android:enabled="false"
            android:exported="true"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher_green">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="app.cleartray.LauncherViolet"
            android:theme="@style/LaunchTheme.Violet"
            android:noHistory="true"
            android:relinquishTaskIdentity="true"
            android:enabled="false"
            android:exported="true"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher_violet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="app.cleartray.LauncherRose"
            android:theme="@style/LaunchTheme.Rose"
            android:noHistory="true"
            android:relinquishTaskIdentity="true"
            android:enabled="false"
            android:exported="true"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher_rose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- flutter_local_notifications: REQUIRED for zonedSchedule() to
             deliver. ScheduledNotificationReceiver catches the AlarmManager
             alarm and posts the notification; without it scheduled reminders
             never appear. ScheduledNotificationBootReceiver re-arms pending
             reminders after a reboot / app update (needs the
             RECEIVE_BOOT_COMPLETED permission declared above).
             ActionBroadcastReceiver catches taps on headless action buttons
             (showsUserInterface: false — Done / Snooze / Move-to-Next-Actions);
             without it the PendingIntent the OS dispatches has no receiver,
             so the tap is silently dropped, the notification doesn't even
             dismiss, and the background isolate never runs. The plugin's own
             AndroidManifest does NOT merge this receiver in — host apps must
             declare it themselves. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- Home-screen widget: "Add to Inbox" tile + live count. -->
        <receiver
            android:name=".CleartrayInboxWidgetProvider"
            android:exported="true"
            android:label="${appLabel} Inbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cleartray_inbox_widget_info"/>
        </receiver>

        <!-- Today widget (ADR 0009): focused Items with a complete checkbox. -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="true"
            android:label="@string/today_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trayzero_today_widget_info"/>
        </receiver>
        <!-- Not exported: only this app's widget PendingIntents complete Items. -->
        <receiver
            android:name=".TodayWidgetActionReceiver"
            android:exported="false" />

        <!-- Quick Settings tile "Capture to Trayzero" (ADR 0009). -->
        <service
            android:name=".CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_capture"
            android:label="@string/tile_capture_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Speech recognition service -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Open links from item notes (url_launcher) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
